# Security - certificates should not be in public repos
cert.pfx
*.pfx
*.pem
*.key
*.cer

# Runtime artifacts
server.log
server.err.log

# OS files
.DS_Store
Thumbs.db

# === Monorepo additions (2026-05-05 split) ===

# Build outputs
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/
.pnpm-store/
.turbo/

# Editor
.vscode/settings.json
.idea/

# Test / coverage
coverage/

# Capacitor — generated native artifacts (Pods/, build/, etc.).
# The ios/ and android/ source trees themselves get checked in once Phase 1 stabilizes.
packages/mobile/ios/App/Pods/
packages/mobile/ios/App/build/
packages/mobile/ios/App/DerivedData/
packages/mobile/android/.gradle/
packages/mobile/android/build/
packages/mobile/android/app/build/
packages/mobile/android/local.properties
packages/mobile/android/.idea/
packages/mobile/capacitor.config.json.bak

# Plugin build artifacts (Gradle / Xcode caches inside the plugin tree)
packages/plugins/*/android/.gradle/
packages/plugins/*/android/build/
packages/plugins/*/android/.idea/
packages/plugins/*/ios/Pods/
packages/plugins/*/ios/build/

# Audit / scratch
docs/LICENSES/_drafts/
tmp_probe.log

# Headless bench harness output (regenerated each `pnpm bench` run)
.last-bench-report.md
packages/web/.last-bench-report.md

# Claude Code internal scheduled-task lock
.claude/scheduled_tasks.lock

# Local agent tooling artifacts (skill mirrors / hooks generated per machine).
# Not product code — `.codex/hooks.json` even references the retired app.js/sw.js
# monolith. Kept local, never committed.
.agents/
.codex/

# Per-machine Claude Code permissions / secrets — checked-in template
# is `.claude/settings.local.json.example`; copy + edit on each dev
# machine. Project-shared baseline lives in `.claude/settings.json`.
.claude/settings.local.json

# Ad-hoc PowerShell helpers from agent diagnostics (server.log greps,
# .mxl inspectors, etc.). Created on the fly when triaging bugs.
.claude_*.ps1
