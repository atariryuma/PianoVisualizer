{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_purpose": "Project-shared Claude Code settings — checked into git. Per-machine secrets / personal preferences live in settings.local.json (which is git-ignored). Permissions here are the SAFE BASELINE for any agent operating on this repo.",
  "permissions": {
    "allow": [
      "Bash(node --check:*)",
      "Bash(node --version)",
      "Bash(pnpm install:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint\\:fix:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm legacy\\:check:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm cap\\:sync:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git restore:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow list:*)",
      "Bash(awk:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:cdn.jsdelivr.net)",
      "WebFetch(domain:capacitorjs.com)",
      "WebFetch(domain:webkit.org)",
      "WebFetch(domain:bugs.webkit.org)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:imslp.org)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase -i:*)",
      "Bash(rm -rf:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git config user.email:*)",
      "Bash(git config user.name:*)",
      "Bash(git config --global:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(security:*)",
      "Bash(open .ssh:*)",
      "Bash(cat .ssh:*)",
      "Bash(cat ~/.ssh:*)",
      "Bash(cat .gnupg:*)",
      "Bash(cat **/cert.pfx)",
      "Bash(cat **/cert.cer)",
      "Bash(cat **/.env)",
      "Read(./cert.pfx)",
      "Read(./cert.cer)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "_comment": "Run `node --check` on app.js / sw.js after any edit so syntax breakage surfaces immediately.",
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --check app.js 2>&1 | head -20 ; node --check sw.js 2>&1 | head -20"
          }
        ]
      }
    ]
  }
}
