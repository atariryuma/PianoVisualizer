{
  "name": "@piano/core",
  "version": "0.14.0",
  "private": true,
  "description": "Platform-agnostic audio/MIDI/render/state engine for Piano Visualizer.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./audio/*": "./src/audio/*.ts",
    "./input/*": "./src/input/*.ts",
    "./render/*": "./src/render/*.ts",
    "./state/*": "./src/state/*.ts",
    "./library/*": "./src/library/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.5",
    "linkedom": "^0.18.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
